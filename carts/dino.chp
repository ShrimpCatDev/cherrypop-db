#CODE
function col(x1,y1,w1,h1,x2,y2,w2,h2)
  return x1 < x2 + w2 and
  x2 < x1 + w1 and
  y1 < y2 + h2 and
  y2 < y1 + h1
end

function lerp(a,b,t)
 return a+(b-a)*t
end

hi=200

function _load()
 pl={x=8,y=96-24,vy=0,s=1}
 anim={
  {1,2}
 }
 t=0
 ts=0
 spd=1
 score=0
 start=false
 st=0
 sy=-16
 sy2=97
 cacti={}
 ct=0
 gameover=false
end

function _tick()
 if start then
  spd=1+math.floor(score/100)*0.1
  if score>hi then hi=score end
  t=t+1
  ct=ct+1
  if ct>=128 then
    table.insert(cacti,{x=128,y=96-24})
    ct=0
  end

  for k,v in ipairs(cacti) do
    v.x=v.x-spd
    if col(v.x,v.y,8,8,pl.x,pl.y,8,8) then
      gameover=true
      start=false
    end
  end

  score=math.floor(t/6)
  
  ts=ts+spd
  pl.vy=pl.vy+0.1
  pl.y=pl.y+pl.vy
  if pl.y>=96-24 then
   pl.vy=0
   pl.y=96-24
  end
  if btnp(4)and pl.y>=96-24 then
   pl.vy=-2
  end
  pl.s=anim[1][(math.floor(t/6)%2)+1]
  sy=lerp(sy,-16,0.1)
  sy2=lerp(sy2,96,0.2)
elseif not gameover then
  sy=lerp(sy,96/2-8,0.1)
  sy2=lerp(sy2,96/2+8,0.1)
  if btnp(5) then
   start=true
  end
else
  pl.s=4
  sy=lerp(sy,96/2-8,0.1)
  sy2=lerp(sy2,96/2+8,0.1)
  if btnp(5) then
   gameover=false
   start=true
   _load()
   start=true
  end
end
 st=st+1 

 cls(13)

 local s1=math.floor(-((ts/2)%128))
 map(16,0,16,12,s1,0,0)
 local s2=math.floor(-(((ts/2)-128)%128)+128)
 map(16,0,16,12,s2,0,0)

 local s1=math.floor(-(ts%128))
 map(0,0,16,12,s1,0,0)
 local s2=math.floor(-((ts-128)%128)+128)
 map(0,0,16,12,s2,0,0)

 for k,v in ipairs(cacti) do
    spr(32,math.floor(v.x),v.y,0)
 end

 if pl.vy~=0 and not gameover then
  spr(3,pl.x,pl.y,0)
 else
  spr(pl.s,pl.x,pl.y,0)
 end
 print(score,1,1,15)

 local s="hi:"..hi 
 print(s,128-string.len(s)*5,1,15)
 
 if not gameover then
  for i=0,3 do
    spr(i+33,i*8+128/2-16,sy+math.cos((st/8)+i*0.8)*3,0)
  end

   local s="press x/b"
   print(s,64-(string.len(s)*5)/2,sy2,15)
 else
  for i=0,3 do
    spr(i+38,i*8+128/2-16,sy+math.cos((st/8)+i*0.8)*3,0)
  end

  local s="press x/b"
  print(s,64-(string.len(s)*5)/2,sy2,15)
 end
end
